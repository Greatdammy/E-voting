# .NET
backend/**/bin/
backend/**/obj/
*.user

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Secrets / local config — never commit real values
# (.env.development etc. without ".local" are committed on purpose —
# they hold non-secret defaults like the local API origin, per Vite's
# own convention: https://vitejs.dev/guide/env-and-mode)
.env
.env.local
.env.*.local
appsettings.Development.json
appsettings.Local.json
backend/src/EVoting.API/web.config

# IDE / OS
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
